# ─────────────────────────────────────────────────────────────────────────────
# Example backend configuration for sql_backend.py (Flask).
# Copy to `.env` and fill in real values. `.env` is gitignored — never commit it.
# ─────────────────────────────────────────────────────────────────────────────

# ── Active Directory / LDAP ──────────────────────────────────────────────────
AD_ENABLED=true
LOCAL_AUTH_ENABLED=true
AD_SERVER=your-ad-host.example.local
AD_PORT=389
AD_DOMAIN=example.local
AD_BASE_DN=DC=example,DC=local
AD_USE_SSL=false
AD_START_TLS=true
AD_TLS_VALIDATE=true
AD_AUTH_MODE=SIMPLE
AD_USER_DN_TEMPLATE={username}@{domain}
AD_CONNECT_TIMEOUT=8
AD_RECEIVE_TIMEOUT=10
AD_USER_FILTER=(&(objectClass=user)(objectCategory=person)(sAMAccountName={username})(!(userAccountControl:1.2.840.113556.1.4.803:=2)))
AD_ALLOWED_GROUPS=
AD_CA_CERT_FILE=
AD_EDITOR_GROUPS=

# ── Local dev account (used only when AD is unreachable) ─────────────────────
# DEV ONLY. In production set LOCAL_AUTH_ENABLED=false.
LOCAL_AUTH_USER=Admin
LOCAL_AUTH_PASSWORD=change-me
LOCAL_AUTH_GROUP=Admin

# ── Web session / cookie ─────────────────────────────────────────────────────
# Generate a random value, e.g. `python -c "import secrets;print(secrets.token_hex(32))"`
FLASK_SECRET_KEY=generate-a-random-64-char-hex-secret
SESSION_LIFETIME_DAYS=1
COOKIE_SECURE=false
CORS_ALLOWED_ORIGINS=

# App-group bootstrap: AD sAMAccountNames that are always full admins.
INITIAL_ADMINS=your-admin-username

# ── SQL Server (backend data source) ─────────────────────────────────────────
# Windows/Trusted auth — no password needed.
DB_SERVER=your-sql-host\your-instance
DB_DATABASE=YOUR_DATABASE
DB_TABLE_A=dbo.ACS
DB_TABLE_B=dbo.PPS
DB_TABLE_C=dbo.VIEW_COSTSHEET_WISDOM
